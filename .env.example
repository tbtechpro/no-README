# QAF Support AI — local environment. Copy to `.env` (never commit `.env`).
# App and database run locally for now: no cloud accounts needed.

# Database: Postgres everywhere (Neon). Same string works locally and on Vercel.
# Pooled (-pooler) for runtime, direct (no -pooler) for `prisma db push`.
# Local: DATABASE_URL="file:./dev.db"
# Vercel: paste the Neon pooled connection string (starts with postgresql://).
DATABASE_URL="file:./dev.db"
# DIRECT_URL: Neon direct (non-pooled) connection string. Same value shape as
# DATABASE_URL but WITHOUT "-pooler" in the hostname. Needed for schema push.
# Local + Vercel: DIRECT_URL="postgresql://user:pass@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require"

# Local file storage dir for invoked images / attachments (gitignored, TTL-deleted).
STORAGE_DIR="./storage"

# Admin allowlist for the future local console (auth arrives with Admin Console MVP).
ADMIN_ALLOWLIST=""

# WhatsApp numbers allowed to propose/confirm deadline changes (comma-separated,
# international format without +; e.g. ADMIN_NUMBERS="2348000000000,2348111111111").
ADMIN_NUMBERS=""

# WhatsApp provider sandbox (only external dependency; fill in during Phase 0.5).
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
