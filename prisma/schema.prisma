// QAF Support AI — database (SQLite locally, Postgres on Vercel/Neon).
// Same models on both providers: String/DateTime/Boolean/Int only.
// Runtime state lives here (never local JSON on hosted deploys).

model CorpusStatusOverride {
  itemId    String   @id // seed item id, e.g. "c09"
  status    String // approved | draft | retired
  version   Int
  updatedAt DateTime @updatedAt
}

model DeadlineProposal {
  id    String   @id @default("single") // one pending proposal at a time
  label String
  by    String
  dueAt String? // ISO date the proposed label describes (for triggers)
  at    DateTime @default(now())
}

model DeadlineOverlay {
  id     String   @id @default("active") // the applied deadline
  label  String
  source String   @default("admin-announcement")
  by     String
  dueAt  String? // ISO date the label describes (for triggers)
  at     DateTime @default(now())
}

model PauseState {
  id     String   @id @default("global")
  paused Boolean  @default(false)
  at     DateTime @updatedAt
}

model SendLog {
  id        String   @id @default(cuid())
  to        String
  skill     String
  ok        Boolean
  status    Int?
  metaId    String?
  error     String?
  createdAt DateTime @default(now())
}

model ReminderSubscription {
  id        String   @id @default(cuid())
  userKey   String // anonymous client key (localStorage uuid)
  trigger   String // assessment-48h | assessment-6h | new-event | starting-1h | deadline-changed
  createdAt DateTime @default(now())

  @@unique([userKey, trigger])
}

model ReminderInbox {
  id        String   @id @default(cuid())
  userKey   String
  trigger   String
  ref       String // dedupe key: cycle label, event id, or overlay timestamp
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userKey, trigger, ref])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userKey   String   @unique
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (-pooler) URL at runtime
  directUrl = env("DIRECT_URL") // direct (non-pooler) URL for `prisma db push`
}

model CorpusItem {
  id            String    @id @default(cuid())
  type          String
  title         String
  body          String
  sourceLink    String?
  owner         String
  effectiveFrom DateTime
  expiresAt     DateTime?
  version       Int       @default(1)
  status        String    @default("draft") // draft | approved | retired
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DecisionLog {
  id        String   @id @default(cuid())
  msgId     String   @unique
  invoked   Boolean
  skill     String?
  corpusIds String   @default("[]") // JSON array of cited corpus item IDs
  handoff   Boolean  @default(false)
  owner     String?
  latencyMs Int?
  createdAt DateTime @default(now())
}

model Ticket {
  id              String    @id @default(cuid())
  category        String
  owner           String
  slaDue          DateTime?
  status          String    @default("open") // open | resolved | dropped
  redactedExcerpt String?
  resolutionId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Reminder {
  id       String   @id @default(cuid())
  event    String
  audience String
  sendAt   DateTime
  wording  String
  status   String   @default("scheduled") // scheduled | sent | cancelled
}

model Correction {
  id        String   @id @default(cuid())
  badMsgId  String
  fixText   String
  audience  String
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

model ImageJob {
  id           String    @id @default(cuid())
  msgId        String    @unique
  downloadedAt DateTime  @default(now())
  deletedAt    DateTime?
  privacyFlag  Boolean   @default(false)
}
